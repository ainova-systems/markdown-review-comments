# Everything that is not the extension itself. `vsce` ignores .gitignore once
# this file exists, so anything new that must not ship belongs here — and
# `scripts/check-package-contents.mjs` fails the build if something slips past.
.github/**
.vscode/**
.vscode-test/**
docs/**
examples/**
images/README.md
scripts/**
src/**
out/test/**
out/**/*.map
**/*.ts
**/tsconfig.json
**/.gitignore
**/.gitattributes
node_modules/**
*.vsix
AGENTS.md
CLAUDE.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md
# Intelligence development context and generated output. AGENTS.md and
# CLAUDE.md are already excluded above.
.intelligence
.intelligence/**
intelligence
intelligence/**
intelligence.yaml
intelligence.lock
.claude
.claude/**
