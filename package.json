{
  "name": "markdown-review-comments",
  "displayName": "Markdown Review Comments",
  "description": "GitHub-style inline review comments that live inside your Markdown files. Local-first, git-native and AI-friendly — no pull request, no SaaS, no database.",
  "version": "0.3.0",
  "publisher": "ainova-systems",
  "license": "MIT",
  "author": {
    "name": "MB Ainova Systems",
    "url": "https://www.ainovasystems.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ainova-systems/markdown-review-comments.git"
  },
  "homepage": "https://github.com/ainova-systems/markdown-review-comments#readme",
  "bugs": {
    "url": "https://github.com/ainova-systems/markdown-review-comments/issues"
  },
  "qna": "https://github.com/ainova-systems/markdown-review-comments/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown comments",
    "markdown review",
    "review comments",
    "review notes",
    "inline comments",
    "code review",
    "pr review",
    "annotate",
    "annotations",
    "comment",
    "ai",
    "llm",
    "agents",
    "claude",
    "copilot",
    "cursor",
    "adr",
    "spec",
    "documentation"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "pricing": "Free",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Markdown Review Comments only reads and writes the Markdown files you open. It runs no commands, makes no network calls, and has no runtime dependencies."
    },
    "virtualWorkspaces": {
      "supported": true,
      "description": "All edits go through the VS Code text-document API, so remote and virtual file systems are supported."
    }
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownReviewComments.addComment",
        "title": "Add Unresolved Comment",
        "category": "Markdown Review Comments"
      },
      {
        "command": "markdownReviewComments.createComment",
        "title": "Add review note",
        "category": "Markdown Review Comments"
      },
      {
        "command": "markdownReviewComments.resolveThread",
        "title": "Resolve",
        "category": "Markdown Review Comments"
      },
      {
        "command": "markdownReviewComments.resolveComment",
        "title": "Mark Comment Resolved",
        "category": "Markdown Review Comments"
      },
      {
        "command": "markdownReviewComments.navigateToSource",
        "title": "Go to Source Line",
        "category": "Markdown Review Comments"
      },
      {
        "command": "markdownReviewComments.navigateToComment",
        "title": "Go to Comment",
        "category": "Markdown Review Comments"
      },
      {
        "command": "markdownReviewComments.exportReviewContext",
        "title": "Export Review Context",
        "category": "Markdown Review Comments"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownReviewComments.addComment",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownReviewComments.resolveComment",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownReviewComments.exportReviewContext",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownReviewComments.createComment",
          "when": "false"
        },
        {
          "command": "markdownReviewComments.resolveThread",
          "when": "false"
        },
        {
          "command": "markdownReviewComments.navigateToSource",
          "when": "false"
        },
        {
          "command": "markdownReviewComments.navigateToComment",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "markdownReviewComments.addComment",
          "when": "editorLangId == markdown",
          "group": "1_modification@10"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "markdownReviewComments.createComment",
          "group": "inline",
          "when": "commentController == markdownReviewComments && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "markdownReviewComments.resolveThread",
          "group": "inline",
          "when": "commentController == markdownReviewComments && !commentThreadIsEmpty"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownReviewComments.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Markdown Review Comments",
      "properties": {
        "markdownReviewComments.insertSourceMarker": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Insert an inline `<!-- review-note: ID -->` anchor above the commented line. The anchor is the durable, git-visible link between a comment and its source — it moves with the text, so it never goes stale. Inline comment threads and navigation rely on it."
        },
        "markdownReviewComments.removeMarkerOnResolve": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When resolving a comment, also remove its inline `<!-- review-note: ID -->` anchor from the source."
        },
        "markdownReviewComments.unresolvedSectionTitle": {
          "type": "string",
          "default": "Unresolved Comments",
          "markdownDescription": "Title of the level-1 heading that groups unresolved comments at the bottom of the file."
        },
        "markdownReviewComments.removeEmptySection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When the last comment is resolved, remove the now-empty `# Unresolved Comments` section (and a preceding `---` separator)."
        },
        "markdownReviewComments.showInlineComments": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render saved comments as native inline comment threads anchored below the commented line."
        },
        "markdownReviewComments.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a `Go to source` / `Resolve` CodeLens above each comment block in the `# Unresolved Comments` section."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test out/test/*.test.js",
    "verify": "npm run compile && npm test",
    "media": "node scripts/render-media.mjs",
    "package": "vsce package",
    "install-extension": "vsce package -o markdown-review-comments.vsix && code --install-extension markdown-review-comments.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "~1.134.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
